{
  "name": "excalicore",
  "version": "0.13.0",
  "description": "Shared Excalidraw scene handling, TypeScript half: stencils, vocabulary, geometry, elements, scene, fidelity and draw.io export",
  "license": "MIT",
  "private": true,
  "type": "module",
  "files": [
    "typescript/dist"
  ],
  "exports": {
    "./stencils": {
      "types": "./typescript/dist/stencils.d.ts",
      "default": "./typescript/dist/stencils.js"
    },
    "./vocabulary": {
      "types": "./typescript/dist/vocabulary.d.ts",
      "default": "./typescript/dist/vocabulary.js"
    },
    "./geometry": {
      "types": "./typescript/dist/geometry.d.ts",
      "default": "./typescript/dist/geometry.js"
    },
    "./elements": {
      "types": "./typescript/dist/elements.d.ts",
      "default": "./typescript/dist/elements.js"
    },
    "./fontmetrics": {
      "types": "./typescript/dist/fontmetrics.d.ts",
      "default": "./typescript/dist/fontmetrics.js"
    },
    "./scene": {
      "types": "./typescript/dist/scene.d.ts",
      "default": "./typescript/dist/scene.js"
    },
    "./fidelity": {
      "types": "./typescript/dist/fidelity.d.ts",
      "default": "./typescript/dist/fidelity.js"
    },
    "./drawio": {
      "types": "./typescript/dist/drawio.d.ts",
      "default": "./typescript/dist/drawio.js"
    }
  },
  "scripts": {
    "test": "node --test typescript/tests/*.test.ts",
    "check": "tsc -p typescript",
    "build": "tsc -p typescript/tsconfig.build.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "typescript": "~6.0.2"
  }
}
