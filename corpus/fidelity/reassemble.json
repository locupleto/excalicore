{
  "doc": "reassemble() and the round trip, executed from python/excalicore/fidelity.py. `reassemble` cases give `rows` as plain objects keyed by column name (what a SQL cursor returns) and expect the elements back. `roundTrip` cases give `elements` inline or a corpus `scene` (optionally with `reversed`: rows handed over in reverse order) and expect true when reassemble(explode(x)) equals x exactly.",
  "cases": [
    {
      "fn": "roundTrip",
      "name": "the corpus scene arrow-bindings survives exactly",
      "scene": "arrow-bindings",
      "expect": true
    },
    {
      "fn": "roundTrip",
      "name": "the corpus scene arrow-bindings survives exactly when rows arrive reversed",
      "scene": "arrow-bindings",
      "reversed": true,
      "expect": true
    },
    {
      "fn": "roundTrip",
      "name": "the corpus scene bound-labels survives exactly",
      "scene": "bound-labels",
      "expect": true
    },
    {
      "fn": "roundTrip",
      "name": "the corpus scene bound-labels survives exactly when rows arrive reversed",
      "scene": "bound-labels",
      "reversed": true,
      "expect": true
    },
    {
      "fn": "roundTrip",
      "name": "the corpus scene freedraw survives exactly",
      "scene": "freedraw",
      "expect": true
    },
    {
      "fn": "roundTrip",
      "name": "the corpus scene freedraw survives exactly when rows arrive reversed",
      "scene": "freedraw",
      "reversed": true,
      "expect": true
    },
    {
      "fn": "roundTrip",
      "name": "the corpus scene image-and-files survives exactly",
      "scene": "image-and-files",
      "expect": true
    },
    {
      "fn": "roundTrip",
      "name": "the corpus scene image-and-files survives exactly when rows arrive reversed",
      "scene": "image-and-files",
      "reversed": true,
      "expect": true
    },
    {
      "fn": "roundTrip",
      "name": "the corpus scene instance-group survives exactly",
      "scene": "instance-group",
      "expect": true
    },
    {
      "fn": "roundTrip",
      "name": "the corpus scene instance-group survives exactly when rows arrive reversed",
      "scene": "instance-group",
      "reversed": true,
      "expect": true
    },
    {
      "fn": "roundTrip",
      "name": "the corpus scene stencil-instances survives exactly",
      "scene": "stencil-instances",
      "expect": true
    },
    {
      "fn": "roundTrip",
      "name": "the corpus scene stencil-instances survives exactly when rows arrive reversed",
      "scene": "stencil-instances",
      "reversed": true,
      "expect": true
    },
    {
      "fn": "roundTrip",
      "name": "inline elements: nulls, anonymous, unknown fields, non-ASCII",
      "elements": [
        {
          "id": "a",
          "type": "rectangle",
          "x": 1.5,
          "y": 2,
          "width": 3,
          "height": 4,
          "angle": 0.25,
          "seed": 9,
          "boundElements": [
            {
              "id": "t",
              "type": "text"
            }
          ],
          "future": {
            "deep": [
              1,
              {
                "x": null
              }
            ]
          }
        },
        {
          "type": "line",
          "x": null,
          "y": null
        },
        {
          "id": "c",
          "type": "text",
          "angle": null,
          "text": "caf\u00e9"
        }
      ],
      "expect": true
    },
    {
      "fn": "reassemble",
      "name": "none",
      "rows": null,
      "expect": []
    },
    {
      "fn": "reassemble",
      "name": "no rows",
      "rows": [],
      "expect": []
    },
    {
      "fn": "reassemble",
      "name": "a row with typed columns",
      "rows": [
        {
          "element_id": "a",
          "z": 0,
          "type": "rectangle",
          "x": 1,
          "y": 2,
          "width": 3,
          "height": 4,
          "angle": 0.5,
          "json": "{\"seed\": 9}",
          "anonymous": 0
        }
      ],
      "expect": [
        {
          "seed": 9,
          "id": "a",
          "type": "rectangle",
          "x": 1,
          "y": 2,
          "width": 3,
          "height": 4,
          "angle": 0.5
        }
      ]
    },
    {
      "fn": "reassemble",
