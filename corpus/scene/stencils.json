{
  "doc": "instanceOf(), stencilSummary() and bbox() executed from python/excalicore/scene.py. stencilSummary cases give the `instance` id and its `members` inline, or a corpus `scene` whose elements carrying that instance are the members. bbox cases give `elements` (or a `scene`); `expect` is [width, height].",
  "cases": [
    {
      "fn": "instanceOf",
      "name": "an element carrying the tag",
      "element": {
        "id": "a",
        "type": "rectangle",
        "x": 0,
        "y": 0,
        "width": 10,
        "height": 10,
        "customData": {
          "stencil": {
            "name": "widget",
            "instance": "g-1"
          }
        }
      },
      "expect": "g-1"
    },
    {
      "fn": "instanceOf",
      "name": "an element with no customData",
      "element": {
        "id": "a",
        "type": "rectangle",
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 50,
        "strokeColor": "#1e1e1e",
        "backgroundColor": "transparent",
        "seed": 1,
        "version": 3,
        "versionNonce": 99
      },
      "expect": null
    },
    {
      "fn": "instanceOf",
      "name": "customData that is not an object",
      "element": {
        "customData": [
          1
        ]
      },
      "expect": null
    },
    {
      "fn": "instanceOf",
      "name": "a stencil tag that is not an object",
      "element": {
        "customData": {
          "stencil": "x"
        }
      },
      "expect": null
    },
    {
      "fn": "instanceOf",
      "name": "a tag with no instance",
      "element": {
        "customData": {
          "stencil": {
            "name": "n"
          }
        }
      },
      "expect": null
    },
    {
      "fn": "instanceOf",
      "name": "an empty instance",
      "element": {
        "customData": {
          "stencil": {
            "instance": ""
          }
        }
      },
      "expect": null
    },
    {
      "fn": "instanceOf",
      "name": "a numeric instance is read as its string",
      "element": {
        "customData": {
          "stencil": {
            "instance": 12
          }
        }
      },
      "expect": "12"
    },
    {
      "fn": "instanceOf",
      "name": "the pre-contract stamp tags are not read",
      "element": {
        "customData": {
          "stamp": "Operator",
          "stampGroup": "sg-77"
        }
      },
      "expect": null
    },
