      "expect": {
        "prose": "{\"wrapper\": {\"elements\": [{\"id\": \"a\", \"type\": \"rectangle\", \"x\": 1, \"y\": 2}]}}",
        "patch": null
      }
    },
    {
      "fn": "extractPatch",
