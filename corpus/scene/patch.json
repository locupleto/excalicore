{
  "doc": "saneGeometry(), validPatch() and extractPatch() executed from python/excalicore/scene.py. extractPatch cases give the model's `message` inline, or a corpus `reply` by name, and expect {prose, patch} with patch null when nothing valid parses. Options: `opaque` (list), `maxCoord`.",
  "cases": [
    {
      "fn": "saneGeometry",
      "name": "no coordinates at all",
      "element": {
        "type": "rectangle"
      },
      "expect": true
    },
    {
      "fn": "saneGeometry",
      "name": "ordinary numbers",
      "element": {
        "x": 1,
        "y": -2.5,
        "width": 300,
        "height": 4
      },
      "expect": true
    },
    {
      "fn": "saneGeometry",
      "name": "a null is absent",
      "element": {
        "x": null,
        "width": null
      },
      "expect": true
    },
    {
      "fn": "saneGeometry",
      "name": "a boolean is not a coordinate",
      "element": {
        "x": true
      },
      "expect": false
    },
    {
      "fn": "saneGeometry",
      "name": "a string is not a coordinate",
      "element": {
        "width": "10"
      },
      "expect": false
    },
    {
      "fn": "saneGeometry",
      "name": "a list is not a coordinate",
      "element": {
        "height": [
          1
        ]
      },
      "expect": false
    },
    {
      "fn": "saneGeometry",
      "name": "exactly the bound is fine",
      "element": {
        "x": 1000000,
        "y": -1000000
      },
      "expect": true
    },
    {
      "fn": "saneGeometry",
      "name": "one past the bound is not",
      "element": {
        "y": 1000001
      },
      "expect": false
    },
    {
      "fn": "saneGeometry",
      "name": "a negative past the bound is not",
      "element": {
        "x": -1000000.5
      },
      "expect": false
    },
    {
      "fn": "saneGeometry",
      "name": "a tighter bound",
      "element": {
        "x": 500
      },
      "options": {
        "maxCoord": 100
      },
      "expect": false
    },
    {
      "fn": "saneGeometry",
      "name": "a looser bound",
      "element": {
        "x": 5000000
      },
      "options": {
        "maxCoord": 10000000
      },
      "expect": true
    },
    {
      "fn": "saneGeometry",
      "name": "only x, y, width and height are checked",
      "element": {
        "x": 1,
        "points": [
          [
            1000000000000.0,
            0
          ]
        ],
        "angle": 1000000000000.0
      },
      "expect": true
    },
    {
      "fn": "validPatch",
      "name": "an element with a type",
      "obj": {
        "elements": [
          {
            "type": "rectangle",
            "x": 1,
            "y": 2
          }
        ]
      },
      "expect": {
        "elements": [
          {
            "type": "rectangle",
            "x": 1,
            "y": 2
          }
        ],
        "delete": []
      }
    },
    {
      "fn": "validPatch",
      "name": "an element with no type",
      "obj": {
        "elements": [
          {
            "x": 1,
            "y": 2
          }
        ]
      },
      "expect": null
    },
    {
      "fn": "validPatch",
      "name": "an element with an empty type",
      "obj": {
        "elements": [
          {
            "type": "",
            "x": 1,
            "y": 2
          }
        ]
      },
      "expect": null
    },
    {
      "fn": "validPatch",
      "name": "a deletion alone",
      "obj": {
        "delete": [
          "n7"
        ]
      },
      "expect": {
        "elements": [],
        "delete": [
          "n7"
        ]
      }
    },
    {
      "fn": "validPatch",
      "name": "deletions drop what is not a string",
      "obj": {
        "delete": [
          "a",
          7,
          null,
          "b",
          [
            "c"
          ]
        ]
      },
      "expect": {
        "elements": [],
        "delete": [
          "a",
          "b"
        ]
      }
    },
    {
      "fn": "validPatch",
      "name": "an empty patch",
      "obj": {
        "elements": [],
        "delete": []
      },
      "expect": null
    },
    {
      "fn": "validPatch",
      "name": "an empty object",
      "obj": {},
      "expect": null
    },
    {
      "fn": "validPatch",
      "name": "not an object: a list",
      "obj": [
        {
          "type": "rectangle"
        }
      ],
      "expect": null
    },
    {
      "fn": "validPatch",
      "name": "not an object: a string",
      "obj": "elements",
      "expect": null
    },
    {
      "fn": "validPatch",
      "name": "not an object: null",
      "obj": null,
      "expect": null
    },
    {
      "fn": "validPatch",
      "name": "not an object: a number",
      "obj": 3,
      "expect": null
    },
    {
      "fn": "validPatch",
      "name": "elements that is not a list counts as none",
      "obj": {
        "elements": {
          "type": "rectangle"
        },
        "delete": [
          "a"
        ]
      },
      "expect": {
        "elements": [],
        "delete": [
          "a"
        ]
      }
    },
    {
      "fn": "validPatch",
      "name": "delete that is not a list counts as none",
      "obj": {
        "elements": [
          {
            "type": "line"
          }
        ],
        "delete": "a"
      },
      "expect": {
        "elements": [
          {
            "type": "line"
          }
        ],
        "delete": []
      }
    },
    {
      "fn": "validPatch",
      "name": "an element that is not an object rejects the patch",
      "obj": {
        "elements": [
          {
            "type": "line"
          },
          "box"
        ]
      },
      "expect": null
    },
    {
      "fn": "validPatch",
      "name": "one insane coordinate rejects the patch",
      "obj": {
        "elements": [
          {
            "type": "line",
            "x": 1
          },
          {
            "type": "line",
            "x": 1000000000.0
          }
        ]
      },
      "expect": null
    },
    {
      "fn": "validPatch",
      "name": "opaque elements are dropped, the rest stands",
      "obj": {
        "elements": [
          {
            "type": "freedraw",
            "id": "s"
          },
          {
            "type": "image",
            "id": "i"
          },
          {
            "type": "stencil",
            "id": "t"
          },
          {
            "type": "rectangle",
            "id": "r"
          }
        ]
      },
      "expect": {
        "elements": [
          {
            "type": "rectangle",
            "id": "r"
          }
        ],
        "delete": []
      }
    },
    {
      "fn": "validPatch",
      "name": "a patch of opaque elements alone says nothing",
      "obj": {
        "elements": [
          {
            "type": "freedraw",
            "id": "s"
          }
        ]
      },
      "expect": null
    },
    {
      "fn": "validPatch",
      "name": "opaque elements alone plus a deletion is still a patch",
      "obj": {
        "elements": [
          {
            "type": "image",
            "id": "i"
          }
        ],
        "delete": [
          "x"
        ]
      },
      "expect": {
        "elements": [],
        "delete": [
          "x"
        ]
      }
    },
    {
      "fn": "validPatch",
      "name": "a custom opaque set",
      "obj": {
        "elements": [
          {
            "type": "rectangle",
            "id": "r"
          },
          {
            "type": "line",
            "id": "l"
          }
        ]
      },
      "options": {
        "opaque": [
          "rectangle"
        ]
      },
      "expect": {
        "elements": [
          {
            "type": "line",
            "id": "l"
          }
        ],
        "delete": []
      }
    },
    {
      "fn": "validPatch",
      "name": "an empty opaque set lets a stroke through",
      "obj": {
        "elements": [
          {
            "type": "freedraw",
            "id": "s"
          }
        ]
      },
      "options": {
        "opaque": []
      },
      "expect": {
        "elements": [
          {
            "type": "freedraw",
            "id": "s"
          }
        ],
        "delete": []
      }
    },
    {
