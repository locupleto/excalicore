          }
        ]
      },
      "expect": {
        "elements": [
          {
            "stencil": 5,
            "type": "rectangle"
          }
        ],
        "delete": []
      }
    },
    {
      "fn": "validPatch",
      "name": "the old stamp placement is refused",
      "obj": {
        "elements": [
