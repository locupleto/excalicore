      "expect": {
        "prose": "I prefer",
        "patch": {
          "elements": [
            {
              "id": "a",
              "type": "rectangle",
              "x": 1,
              "y": 2
            }
          ],
          "delete": []
        }
      }
    },
    {
      "fn": "extractPatch",
      "name": "braces in prose that are not JSON",
