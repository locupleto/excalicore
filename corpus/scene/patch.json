          }
        ]
      },
      "expect": {
        "elements": [
          {
            "stencil": " ",
            "type": "rectangle"
          }
        ],
        "delete": []
      }
    },
    {
      "fn": "validPatch",
      "name": "a non-string stencil name falls back to the type",
